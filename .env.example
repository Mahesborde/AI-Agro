# AgroMind AI - Global Environment Variable Configuration Template
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT (DO NOT COMMIT REAL SECRETS)

# Application Identity & Base Settings
PROJECT_NAME="AgroMind AI"
ENVIRONMENT="development"  # Options: development, staging, production
DEBUG=True
API_V1_STR="/api/v1"

# Security Configurations
# Generate a secure secret key using `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY="change-this-in-production-super-secret-key-agromind"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 Days

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agromind_db"

# CORS Configuration (Allowed Origins formatted as JSON array)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# ML & Artifact Storage Paths
MODEL_ARTIFACTS_DIR="./models"
DATASETS_BASE_DIR="./datasets"
